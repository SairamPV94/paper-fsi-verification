{
    "analysis_stage": "KratosMultiphysics.FSIApplication.fsi_analysis",
    "problem_data": {
        "problem_name": "fsi_lid_driven_cavity",
        "parallel_type": "OpenMP",
        "echo_level": 0,
        "start_time": 0.0,
        "end_time": 70.0
    },
    "solver_settings": {
        "solver_type": "partitioned",
        "coupling_scheme": "dirichlet_neumann",
        "echo_level": 1,
        "structure_solver_settings": {
            "solver_type": "Dynamic",
            "model_part_name": "Structure",
            "domain_size": 2,
            "echo_level": 0,
            "analysis_type": "non_linear",
            "time_integration_method": "implicit",
            "scheme_type": "bossak",
            "model_import_settings": {
                "input_type": "mdpa",
                "input_filename": "fsi_lid_driven_cavity_Structural"
            },
            "material_import_settings": {
                "materials_filename": "StructuralMaterials.json"
            },
            "time_stepping": {
                "time_step": 0.1
            },
            "convergence_criterion": "residual_criterion",
            "displacement_relative_tolerance": 1e-06,
            "displacement_absolute_tolerance": 1e-08,
            "residual_relative_tolerance": 1e-06,
            "residual_absolute_tolerance": 1e-08,
            "max_iteration": 10,
            "rotation_dofs": false
        },
        "fluid_solver_settings": {
            "solver_type": "Monolithic",
            "model_part_name": "FluidModelPart",
            "domain_size": 2,
            "model_import_settings": {
                "input_type": "mdpa",
                "input_filename": "fsi_lid_driven_cavity_Fluid"
            },
            "material_import_settings": {
                "materials_filename": "FluidMaterials.json"
            },
            "echo_level": 0,
            "compute_reactions": true,
            "maximum_iterations": 10,
            "relative_velocity_tolerance": 1e-06,
            "absolute_velocity_tolerance": 1e-08,
            "relative_pressure_tolerance": 1e-06,
            "absolute_pressure_tolerance": 1e-08,
            "volume_model_part_name": "FluidModelPart.Parts_Fluid",
            "skin_parts": [
                "FluidModelPart.Outlet2D_Outlet",
                "FluidModelPart.NoSlip2D_NoSlip",
                "FluidModelPart.FluidNoSlipInterface2D_FluidInterface"
            ],
            "no_skin_parts": [
                "FluidModelPart.VelocityConstraints2D_Inlet",
                "FluidModelPart.ALEMeshDisplacementBC2D_ALEMeshBCx",
                "FluidModelPart.ALEMeshDisplacementBC2D_ALEMeshBCy"
            ],
            "time_stepping": {
                "automatic_time_step": false,
                "time_step": 0.1
            },
            "formulation": {
                "element_type": "vms",
                "dynamic_tau": 1.0
            }
        },
        "mesh_solver_settings": {
            "echo_level": 0,
            "domain_size": 2,
            "model_part_name": "FluidModelPart",
            "solver_type": "structural_similarity"
        },
        "coupling_settings": {
            "nl_tol": 1e-06,
            "nl_max_it": 20,
            "solve_mesh_at_each_iteration": true,
            "coupling_strategy_settings": {
                "solver_type": "MVQN"
            },
            "structure_interfaces_list": [
                "Structure.StructureInterface2D_StructureInterface"
            ],
            "fluid_interfaces_list": [
                "FluidModelPart.FluidNoSlipInterface2D_FluidInterface"
            ],
            "mapper_settings": [
                {
                    "mapper_face": "unique",
                    "fluid_interface_submodelpart_name": "FluidModelPart.FluidNoSlipInterface2D_FluidInterface",
                    "structure_interface_submodelpart_name": "Structure.StructureInterface2D_StructureInterface"
                }
            ]
        }
    },
    "processes": {
        "structure_constraints_process_list": [
            {
                "python_module": "assign_vector_variable_process",
                "kratos_module": "KratosMultiphysics",
                "process_name": "AssignVectorVariableProcess",
                "Parameters": {
                    "model_part_name": "Structure.DISPLACEMENT_DisplacementBC",
                    "variable_name": "DISPLACEMENT",
                    "constrained": [
                        true,
                        true,
                        true
                    ],
                    "value": [
                        0.0,
                        0.0,
                        0.0
                    ],
                    "interval": [
                        0.0,
                        "End"
                    ]
                }
            }
        ],
        "structure_loads_process_list": [],
        "fluid_initial_conditions_process_list": [],
        "fluid_boundary_conditions_process_list": [
            {
                "python_module": "apply_outlet_process",
                "kratos_module": "KratosMultiphysics.FluidDynamicsApplication",
                "process_name": "ApplyOutletProcess",
                "Parameters": {
                    "model_part_name": "FluidModelPart.Outlet2D_Outlet",
                    "variable_name": "PRESSURE",
                    "constrained": true,
                    "value": 0.0,
                    "hydrostatic_outlet": false,
                    "h_top": 0.0
                }
            },
            {
                "python_module": "apply_noslip_process",
                "kratos_module": "KratosMultiphysics.FluidDynamicsApplication",
                "process_name": "ApplyNoSlipProcess",
                "Parameters": {
                    "model_part_name": "FluidModelPart.NoSlip2D_NoSlip"
                }
            },
            {
                "python_module": "assign_vector_variable_process",
                "kratos_module": "KratosMultiphysics",
                "process_name": "AssignVectorVariableProcess",
                "Parameters": {
                    "model_part_name": "FluidModelPart.VelocityConstraints2D_Inlet",
                    "variable_name": "VELOCITY",
                    "constrained": [
                        true,
                        true,
                        true
                    ],
                    "value": [
                        "(1-cos(0.4*pi*t))*((y-0.875)/0.125)",
                        0.0,
                        0.0
                    ],
                    "interval": [
                        0.0,
                        "End"
                    ]
                }
            },
            {
                "python_module": "assign_vector_variable_process",
                "kratos_module": "KratosMultiphysics",
                "process_name": "AssignVectorVariableProcess",
                "Parameters": {
                    "model_part_name": "FluidModelPart.ALEMeshDisplacementBC2D_ALEMeshBCx",
                    "variable_name": "MESH_DISPLACEMENT",
                    "constrained": [
                        true,
                        false,
                        true
                    ],
                    "value": [
                        0.0,
                        0.0,
                        0.0
                    ],
                    "interval": [
                        0.0,
                        "End"
                    ]
                }
            },
            {
                "python_module": "assign_vector_variable_process",
                "kratos_module": "KratosMultiphysics",
                "process_name": "AssignVectorVariableProcess",
                "Parameters": {
                    "model_part_name": "FluidModelPart.ALEMeshDisplacementBC2D_ALEMeshBCy",
                    "variable_name": "MESH_DISPLACEMENT",
                    "constrained": [
                        false,
                        true,
                        true
                    ],
                    "value": [
                        0.0,
                        0.0,
                        0.0
                    ],
                    "interval": [
                        0.0,
                        "End"
                    ]
                }
            }
        ],
        "fluid_gravity": [
            {
                "python_module": "assign_vector_by_direction_process",
                "kratos_module": "KratosMultiphysics",
                "process_name": "AssignVectorByDirectionProcess",
                "Parameters": {
                    "model_part_name": "FluidModelPart.Parts_Fluid",
                    "variable_name": "BODY_FORCE",
                    "modulus": 0.0,
                    "constrained": false,
                    "direction": [
                        0.0,
                        -1.0,
                        0.0
                    ]
                }
            }
        ],
        "fluid_auxiliar_process_list": []
    },
    "output_processes": {
        "vtk_output": [
            {
                "python_module": "vtk_output_process",
                "kratos_module": "KratosMultiphysics",
                "process_name": "VtkOutputProcess",
                "Parameters": {
                    "model_part_name": "Structure.Parts_Structure",
                    "output_control_type": "step",
                    "output_interval": 10,
                    "file_format": "binary",
                    "output_precision": 8,
                    "output_sub_model_parts": false,
                    "output_path": "vtk_output",
                    "save_output_files_in_folder": true,
                    "nodal_solution_step_data_variables": [
                        "DISPLACEMENT",
                        "VELOCITY",
                        "ACCELERATION"
                    ]
                }
            },
            {
                "python_module": "vtk_output_process",
                "kratos_module": "KratosMultiphysics",
                "process_name": "VtkOutputProcess",
                "Parameters": {
                    "model_part_name": "FluidModelPart.Parts_Fluid",
                    "output_control_type": "step",
                    "output_interval": 10,
                    "file_format": "binary",
                    "output_precision": 8,
                    "output_sub_model_parts": false,
                    "output_path": "vtk_output",
                    "save_output_files_in_folder": true,
                    "nodal_solution_step_data_variables": [
                        "VELOCITY",
                        "PRESSURE",
                        "MESH_DISPLACEMENT"
                    ]
                }
            }
        ]
    }
}